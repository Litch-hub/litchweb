</main>

<footer>
  <div class="container">
    <div class="social-links">
      <a href="https://www.linkedin.com/in/litshedzani-nguluvhe-079494249/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
      <a href="tel:+27656796229"><i class="fas fa-phone-alt"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
    </div>
    <p>© 2026 Litch.web — Built by Litshedzani Nguluvhe. No fake clients, just real work.</p>
  </div>
