        <p style="text-align:center; margin-bottom:1.5rem;">📞 <a href="tel:+27656796229" class="phone-big">065 679 6229</a> (call or WhatsApp)</p>
        
        <!-- Formspree integration with your live endpoint -->
        <form action="https://formspree.io/f/xbdegaeg" method="POST">
